{
  "$schema": "https://www.masterpackager.com/support-master-packager-dev/mpdev-schema.json",
  "outputTypes": [
    "msi",
    "msix"
  ],
  "outputDirectory": "build/.rcache/windows-installers",
  "outputFileName": "GitManager_$.version_$.platform",
  "compressionLevel": "Normal",
  "packageName": "GitManager",
  "publisher": "Kastrick",
  "version": "1.0.0.0",
  "platform": "x64",
  "installDir": "%LOCALAPPDATA%\\Programs\\Kastrick's Software\\GitManager",
  "icon": "frontend/static/image/git-managar-orange_default-black.png",
  "fileSystemEntries": [
    {
      "sourcePath": "%GITMANAGER_APP_SOURCE%",
      "targetPath": "$.installDir"
    }
  ],
  "shortcuts": [
    {
      "name": "GitManager",
      "description": "Git workspace manager by Kastrick",
      "target": "$.installDir\\gitmanager.exe",
      "icon": "frontend/static/image/git-managar-orange_default-black.png"
    }
  ],
  "msix": {
    "capabilities": [
      "runFullTrust",
      "internetClient",
      "privateNetworkClientServer"
    ],
    "packageDescription": "GitManager \u2014 a native Git workspace manager by Kastrick.",
    "digitalSignature": {
      "signWith": "GenerateTestCertificate",
      "timestampServer": "http://timestamp.acs.microsoft.com"
    }
  },
  "msi": {
    "upgradeCode": "6B4A7D19-8E32-4C81-AF53-2D9B7E1C4065",
    "properties": [
      {
        "name": "ALLUSERS",
        "value": "2"
      },
      {
        "name": "MSIINSTALLPERUSER",
        "value": "1"
      }
    ],
    "detectRunningProcesses": [
      "gitmanager.exe",
      "crash_helper.exe",
      "gitmanager.service.exe",
      "git-manager.exe",
      "git-manager-service.exe",
      "gitmanager-service.exe",
      "crash_helper-x86_64-pc-windows-msvc.exe",
      "crash_helper-i686-pc-windows-msvc.exe",
      "crash_helper-aarch64-pc-windows-msvc.exe",
      "gitmanager.service-x86_64-pc-windows-msvc.exe",
      "gitmanager.service-i686-pc-windows-msvc.exe",
      "gitmanager.service-aarch64-pc-windows-msvc.exe",
      "gitm.exe"
    ],
    "packageDependencies": [
      {
        "displayName": "Microsoft Edge WebView2 Runtime",
        "namePattern": "Microsoft Edge WebView2 Runtime",
        "install": {
          "winGet": {
            "id": "Microsoft.EdgeWebView2Runtime"
          }
        }
      }
    ],
    "installDialog": {
      "packageDescription": "A native Git workspace manager for local and remote repositories, built by Kastrick.",
      "publisherUrl": "https://kastrick.vercel.app",
      "releaseNotesUrl": "https://github.com/Kate-alt-69/GitManager/releases",
      "primaryAccent": "#F97316",
      "promptAppsAfterInstall": [
        {
          "displayName": "Launch GitManager",
          "file": "$.installDir\\resources\\gitmanager-setup.exe"
        }
      ]
    },
    "customActions": {
      "exe": [
        {
          "name": "StopGitManagerCoreService",
          "filePath": "$.installDir\\resources\\crash_helper.exe",
          "arguments": "--stop-service",
          "condition": "Installed",
          "sequence": "StartOfExecution",
          "continueOnError": true
        }
      ]
    }
  },
  "installer": {
    "customActions": {
      "exe": [
        {
          "name": "ResetGitManagerFirstRunOnUninstall",
          "filePath": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
          "arguments": "-NoProfile -ExecutionPolicy Bypass -Command \"$cfg = Join-Path $env:LOCALAPPDATA 'kastrick''s_software\\config\\GitManager\\preferences.json'; if (Test-Path $cfg) { try { $j = Get-Content -Raw $cfg | ConvertFrom-Json; $j.firstRunComplete = $false; $j | ConvertTo-Json -Depth 10 | Set-Content -Encoding UTF8 $cfg } catch { Remove-Item -Force $cfg -ErrorAction SilentlyContinue } }; Remove-Item -Force ($cfg + '.previous'), ($cfg + '.bak') -ErrorAction SilentlyContinue\"",
          "condition": "REMOVE=\"ALL\" AND NOT UPGRADINGPRODUCTCODE",
          "sequence": "EndOfExecution",
          "continueOnError": true
        }
      ]
    }
  }
}

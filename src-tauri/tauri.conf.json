{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitManager",
  "version": "1.0.0",
  "identifier": "com.gitmanager.desktop",
  "build": {
    "frontendDist": "../.cache/nextjs-engine/workspace/out",
    "beforeBuildCommand": "python tools/nextjs_engine_source.py build --project-root .",
    "beforeDevCommand": "python tools/nextjs_engine_source.py dev --project-root .",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GitManager — Pure-Rust Local & Remote Git Tree Explorer",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'self'; img-src 'self' https://github.com https://gitlab.com https://avatars.githubusercontent.com data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://gitlab.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "compression": "lzma",
        "startMenuFolder": "Kastrick's Software",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../tools/gitmanager_cleaner.py": "tools/gitmanager_cleaner.py",
      "../tools/runtime/python": "python"
    },
    "publisher": "Kastrick",
    "copyright": "Copyright © 2026 Kastrick",
    "license": "Apache-2.0",
    "shortDescription": "A free, native Git workspace manager",
    "longDescription": "GitManager is a free and open-source Git workspace manager by Kastrick.",
    "externalBin": [
      "binaries/gitm",
      "binaries/gitmanager-setup"
    ]
  }
}
